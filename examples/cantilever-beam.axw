    },
    {
      "id": "section-inputs",
      "type": "text",
      "page": 0,
      "x": 60,
      "y": 398,
      "w": 780,
      "h": 36,
      "label": "",
      "source": "",
      "precision": 5,
      "outputUnit": "",
      "text": "01   Design parameters",
      "style": "section",
      "color": "default"
    },
    {
      "id": "length",
      "type": "math",
      "page": 0,
      "x": 60,
      "y": 458,
      "w": 370,
      "h": 80,
      "label": "Span length",
      "source": "L := 3 m",
      "precision": 5,
      "outputUnit": "m",
      "text": "",
      "style": "body",
      "color": "default"
    },
    {
      "id": "load",
      "type": "math",
      "page": 0,
      "x": 460,
      "y": 458,
      "w": 370,
      "h": 80,
      "label": "Distributed load",
      "source": "q_load := 4 kN/m",
      "precision": 5,
      "outputUnit": "kN/m",
      "text": "",
      "style": "body",
      "color": "default"
    },
    {
      "id": "modulus",
      "type": "math",
      "page": 0,
      "x": 60,
      "y": 554,
      "w": 370,
      "h": 80,
      "label": "Young’s modulus",
      "source": "E := 210 GPa",
      "precision": 5,
      "outputUnit": "GPa",
      "text": "",
      "style": "body",
      "color": "default"
    },
    {
      "id": "width",
      "type": "math",
      "page": 0,
      "x": 460,
      "y": 554,
      "w": 370,
      "h": 80,
      "label": "Section width",
      "source": "b := 100 mm",
      "precision": 5,
      "outputUnit": "mm",
      "text": "",
      "style": "body",
      "color": "default"
    },
    {
      "id": "height",
      "type": "math",
      "page": 0,
      "x": 60,
      "y": 650,
      "w": 370,
      "h": 80,
      "label": "Section height",
      "source": "h := 180 mm",
      "precision": 5,
      "outputUnit": "mm",
      "text": "",
      "style": "body",
      "color": "default"
    },
    {
      "id": "inertia",
      "type": "math",
      "page": 0,
      "x": 460,
      "y": 650,
      "w": 370,
      "h": 80,
      "label": "Second moment of area",
      "source": "I := b*h^3/12",
      "precision": 5,
      "outputUnit": "mm^4",
      "text": "",
      "style": "body",
      "color": "default"
    },
    {
      "id": "section-response",
      "type": "text",
      "page": 0,
      "x": 60,
      "y": 754,
      "w": 780,
      "h": 36,
      "label": "",
      "source": "",
      "precision": 5,
      "outputUnit": "",
      "text": "02   Deflection response",
      "style": "section",
      "color": "default"
    },
    {
      "id": "deflection-function",
      "type": "math",
      "page": 0,
      "x": 60,
      "y": 812,
      "w": 780,
      "h": 104,
      "label": "Elastic curve",
      "source": "v(x) := q_load*x^2*(6*L^2 - 4*L*x + x^2)/(24*E*I)",
      "precision": 5,
      "outputUnit": "",
      "text": "",
      "style": "body",
      "color": "default"
    },
    {
      "id": "deflection-plot",
      "type": "plot",
      "page": 0,
      "x": 60,
      "y": 944,
      "w": 780,
      "h": 250,
      "label": "Deflection along the span",
      "source": "",
      "precision": 5,
      "outputUnit": "",
      "text": "",
      "style": "body",
      "color": "default",
      "variable": "x",
      "xMin": "0 m",
      "xMax": "L",
      "xUnit": "m",
      "yUnit": "mm",
      "traces": [
        {
          "expression": "v(x)",
          "label": "Design load"
        },
        {
          "expression": "0.6*v(x)",
          "label": "60% load"
        }
      ],
      "samples": 512
    },
    {
      "id": "section-check",
      "type": "text",
      "page": 1,
      "x": 60,
      "y": 70,
      "w": 780,
      "h": 36,
      "label": "",
      "source": "",
      "precision": 5,
      "outputUnit": "",
      "text": "03   Serviceability verification",
      "style": "section",
      "color": "default"
    },
    {
      "id": "check-description",
      "type": "text",
      "page": 1,
      "x": 60,
      "y": 125,
      "w": 780,
      "h": 58,
      "label": "",
      "source": "",
      "precision": 5,
      "outputUnit": "",
      "text": "Compare the maximum elastic deflection at the free end with the project’s span / 250 serviceability limit.",
      "style": "body",
      "color": "default"
    },
    {
      "id": "tip-deflection",
      "type": "math",
      "page": 1,
      "x": 60,
      "y": 210,
      "w": 370,
      "h": 88,
      "label": "Maximum tip deflection",
      "source": "delta_max := v(L)",
      "precision": 5,
      "outputUnit": "mm",
      "text": "",
      "style": "body",
      "color": "green"
    },
    {
      "id": "allowable",
      "type": "math",
      "page": 1,
      "x": 460,
      "y": 210,
      "w": 370,
      "h": 88,
      "label": "Allowable deflection",
      "source": "delta_allow := L/250",
      "precision": 5,
      "outputUnit": "mm",
      "text": "",
      "style": "body",
      "color": "default"
    },
    {
      "id": "utilization",
      "type": "math",
      "page": 1,
      "x": 60,
      "y": 330,
      "w": 370,
      "h": 88,
      "label": "Deflection utilization",
      "source": "utilization := delta_max/delta_allow",
      "precision": 5,
      "outputUnit": "pct",
      "text": "",
      "style": "body",
      "color": "default"
    },
    {
      "id": "verification",
      "type": "math",
      "page": 1,
      "x": 460,
      "y": 330,
      "w": 370,
      "h": 88,
      "label": "Serviceability requirement",
      "source": "delta_max <= delta_allow",
      "precision": 5,
      "outputUnit": "",
      "text": "",
      "style": "body",
      "color": "green"
    },
    {
      "id": "assumptions-heading",
      "type": "text",
      "page": 1,
      "x": 60,
      "y": 478,
      "w": 780,
      "h": 36,
      "label": "",
      "source": "",
      "precision": 5,
      "outputUnit": "",
      "text": "04   Assumptions & references",
      "style": "section",
      "color": "default"
    },
    {
      "id": "assumptions",
      "type": "text",
      "page": 1,
      "x": 60,
      "y": 541,
      "w": 780,
      "h": 164,
      "label": "",
      "source": "",
      "precision": 5,
      "outputUnit": "",
      "text": "Linear-elastic, homogeneous material. Prismatic rectangular cross-section. Small displacements. Ideal fixed support and a static, uniformly distributed transverse load. Shear deformation is neglected.\n\nDeflection: v(L) = q · L⁴ / (8 · E · I). Second moment: I = b · h³ / 12. Verify these assumptions independently for the intended application.",
      "style": "body",
      "color": "default"
    },
    {
      "id": "note",
      "type": "text",
      "page": 1,
      "x": 60,
      "y": 763,
      "w": 780,
      "h": 96,
      "label": "",
      "source": "",
      "precision": 5,
      "outputUnit": "",
      "text": "DESIGN NOTE\nThis worked example demonstrates the calculation engine. It is not a code-compliance check or an independently validated structural design.",
      "style": "callout",
      "color": "default"
    },
    {
      "id": "tip",
      "type": "text",
      "page": 1,
      "x": 60,
      "y": 909,
      "w": 780,
      "h": 66,
      "label": "",
      "source": "",
      "precision": 5,
      "outputUnit": "",
      "text": "Try it: return to page 1 and change the span or load. All dependent results and the plot recalculate automatically. Double-click any math region to edit.",
      "style": "caption",
      "color": "default"
    }
